# Used when running without Docker.
GRIDCONNECT_DB=./data/gridconnect.db
GRIDCONNECT_TIMEZONE=Pacific/Auckland

# Host port the dashboard is published on.
GRIDCONNECT_PORT=8080

# Keep bridge by default. Set to host on Linux, or after enabling Docker Desktop
# host networking, when local Tuya devices cannot be reached from bridge mode.
GRIDCONNECT_NETWORK_MODE=bridge

# Optional: browser username is gridconnect; leave blank for trusted-LAN access.
# The /api/health endpoint stays public so uptime monitors keep working.
GRIDCONNECT_AUTH_PASSWORD=

# Branding shown in the dashboard's Settings footer. Forks can point these at
# their own project; set a value to an empty string to hide that link entirely.
GRIDCONNECT_PROJECT_NAME=GridConnect
GRIDCONNECT_PROJECT_URL=https://github.com/FlashZ/gridconnect
# Defaults to <project url>/blob/main/LICENSE when unset.
GRIDCONNECT_LICENSE_URL=
GRIDCONNECT_SUPPORT_URL=https://buymeacoffee.com/nickkb
